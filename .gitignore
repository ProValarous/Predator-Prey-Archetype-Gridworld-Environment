# Ignore VS Code settings
.vscode/

wiki/

site/

# Ignore Python virtual environments
marl-project-venv2/
venv/
marl_venv/
.new_venv/

# Packaging metadata (regenerated by build/editable install)
*.egg-info/

# Large committed archive (source lives in git history / wiki docs)
wiki_compressed.zip

# Stray scratch file
test_file.md

# Trained model artifacts
*.pkl

# Training curve CSVs (experiment output, not source)
training_curves_*.csv

# Training run output directories
src/baselines/IQL/*_run/
src/baselines/CQL/*_run/
src/baselines/MIXED/*_run/

# Ignore pytest cache
.pytest_cache/
__pycache__/

# Ignore compiled Python files
*.pyc
*.pyo
*.pyd

# Ignore logs and temporary files
*.log
*.tmp

# Ignore environment variables (optional)
.env


# npz tables
src/baselines/CQL/*.npz

src/baselines/IQL/predator_1/
src/baselines/IQL/predator_2/
src/baselines/IQL/prey_1/
src/baselines/IQL/prey_2/
src/baselines/IQL/prey/
src/baselines/IQL/prey/

src/baselines/MIXED/*.npz
src/baselines/MIXED/predator_1/
src/baselines/MIXED/predator_2/
src/baselines/MIXED/prey_1/
src/baselines/MIXED/prey_2/

# IQL trained artifacts (checkpoints and per-agent Q-tables)
src/baselines/IQL/*.npz
src/baselines/IQL/predator/
src/baselines/IQL/prey/

# Generated slide decks (regenerated from slides/*.py and miscellenous/*.py)
slides/*.pdf
slides/*.pptx



# logs
src/baselines/CQL/logs/
src/baselines/IQL/logs/
src/baselines/MIXED/logs/

# Coverage artifacts
.coverage
coverage.xml
htmlcov/
